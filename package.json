{
  "name": "cantarella",
  "version": "1.0.0",
  "description": "批量压缩图片的命令行工具",
  "type": "module",
  "bin": {
    "cantarella": "bin/cli.ts"
  },
  "scripts": {
    "start": "node bin/cli.ts --help",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzl110712/cantarella.git"
  },
  "author": "LeoZhao",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zzl110712/cantarella/issues"
  },
  "homepage": "https://github.com/zzl110712/cantarella#readme",
  "keywords": [
    "image",
    "compress",
    "compression",
    "cli",
    "sharp",
    "webp",
    "avif",
    "jpeg",
    "png",
    "batch",
    "image-optimization"
  ],
  "files": [
    "bin",
    "lib",
    "config.ts"
  ],
  "imports": {
    "#config": "./config.ts",
    "#lib/*": "./lib/*.ts"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "p-limit": "^7.3.1",
    "sharp": "^0.35.4"
  }
