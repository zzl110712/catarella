{
  "compilerOptions": {
    /* 语言与运行环境：Node 22+ 原生 type stripping 直接运行 .ts，无需编译产物 */
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    /* 只做类型检查，不产出 .js（由 Node 直接执行源码） */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,

    /* Node 的 type stripping 只支持"可擦除"语法（不支持 enum / namespace / 参数属性），
       打开此开关让 tsc 在编译期就拦住不兼容写法 */
    "erasableSyntaxOnly": true,

    /* 严格检查 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "config.ts"]
}
